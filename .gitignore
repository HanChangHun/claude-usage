# Claude Code session metadata, worktrees, and per-project state
.claude/

# Tauri / Rust build artifacts (the app/ subproject creates these)
app/src-tauri/target/
app/src-tauri/gen/
app/node_modules/
app/dist/

# Local copies of installers (binary, large; built via `npm run tauri build`)
app/installers/

# Local signing config (contains updater private key password — see app/.env.example)
app/.env

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
