# Copy to app/.env (gitignored) and fill in.
# Used by app/release.ps1 to sign release builds for the in-app updater.

# Path to the Tauri updater private key (minisign format).
# Generated once via: npx tauri signer generate -w "$HOME/.tauri/claude-usage-app.key"
TAURI_SIGNING_PRIVATE_KEY_PATH=C:\Users\<you>\.tauri\claude-usage-app.key

# Password for the private key (set when the key was generated).
# This protects the key file against theft; not a deployment secret per se,
# but if you lose it the key is unusable and you must rotate it (which breaks
# auto-update for existing users — they have to manually reinstall once).
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=<your password>
